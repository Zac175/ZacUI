# Part of ZacUI. These files were lifted out of the main addon so this
# piece can be switched off in the AddOns list on its own. They share
# ZacUI's namespace (_G.ZacUI, published by Core_Boot) and its saved
# variables; every setting still lives in ZacUIDB and in profiles.
# Load order within this file is the same as it was inside ZacUI.

Win_Kit.lua
Win_Merchant.lua
# Classic book and talents on Forever (2026-11-07): every rank from
# Forever's book data, before the spellbook that reads it (returns at
# once on every other game).
Win_SpellbookForever.lua
Win_Spellbook.lua
Win_Talents.lua
# Classic book and talents on Forever (2026-11-07): the three trees from
# Forever's talent data (returns at once on every other game).
Win_TalentsForever.lua
Win_Profession.lua
Win_Trainer.lua
Win_Paperdoll.lua
Win_Character.lua
Win_QuestLog.lua
Win_Mail.lua
Win_Social.lua
Win_PetPaperdoll.lua
Win_CharTabs.lua
Win_Inspect.lua
Win_Ignore.lua
Win_Raid.lua
Win_PvP.lua
Win_LFG.lua
Win_Loot.lua
Win_Macros.lua
Win_Gossip.lua
# Feature cluster 1 (2026-11-07): the coin on the quest reward that sells
# for most, on ZacUI's quest window and the game's own (after Win_Gossip).
Win_QuestRewards.lua
Win_Trade.lua
Win_FlightTimes.lua
Win_Taxi.lua
