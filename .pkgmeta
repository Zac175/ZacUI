# Builds the ZacUI release zip (BigWigsMods/packager).
# The repo holds every Zacui folder side by side; the zip puts each one at
# the top level, exactly as they sit in Interface\AddOns. ZacLayout is never
# in this repo.
package-as: Zacui

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - README.md
  - CHANGELOG.md
  - __deltest

move-folders:
  ZacUI/Zacui: Zacui
  ZacUI/Zacui_Auras: Zacui_Auras
  ZacUI/Zacui_Bags: Zacui_Bags
  ZacUI/Zacui_Bars: Zacui_Bars
  ZacUI/Zacui_Blessings: Zacui_Blessings
  ZacUI/Zacui_BuffReminders: Zacui_BuffReminders
  ZacUI/Zacui_Clicks: Zacui_Clicks
  ZacUI/Zacui_Consumables: Zacui_Consumables
  ZacUI/Zacui_HUD: Zacui_HUD
  ZacUI/Zacui_Maps: Zacui_Maps
  ZacUI/Zacui_Meter: Zacui_Meter
  ZacUI/Zacui_Nameplates: Zacui_Nameplates
  ZacUI/Zacui_QoL: Zacui_QoL
  ZacUI/Zacui_RaidMods: Zacui_RaidMods
  ZacUI/Zacui_RaidTools: Zacui_RaidTools
  ZacUI/Zacui_SBT: Zacui_SBT
  ZacUI/Zacui_UnitFrames: Zacui_UnitFrames
  ZacUI/Zacui_Windows: Zacui_Windows
  ZacUI/Zacui_WorldMap: Zacui_WorldMap
