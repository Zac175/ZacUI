# Part of ZacUI. These files were lifted out of the main addon so this
# piece can be switched off in the AddOns list on its own. They share
# ZacUI's namespace (_G.ZacUI, published by Core_Boot) and its saved
# variables; every setting still lives in ZacUIDB and in profiles.
# Load order within this file is the same as it was inside ZacUI.

NP_PortData.lua
NP_Core.lua
NP_FX.lua
NP_Health.lua
NP_Cast.lua
# the Classic look's vanilla plate border (wraps the two layout passes above)
NP_ClassicPlate.lua
# Feature cluster 2 (2026-11-07): the interrupt-ready tint on the cast bars
# (off by default; nothing made or ticking while off)
NP_Interrupt.lua
NP_Auras.lua
NP_Extras.lua
NP_Threat.lua
NP_Scripts.lua
NP_SoftTarget.lua
NP_Debuffs.lua
NP_Preview.lua
Crosshair_Core.lua
NP_Crosshair.lua
Config_PagesNameplates.lua
Config_PagesNPScripts.lua
# Drag to customise in the plates preview (ZacUI's UIF_PreviewDrag): the
# sample plate's pieces. After the pages (it registers by preview key).
NP_PreviewDrag.lua
