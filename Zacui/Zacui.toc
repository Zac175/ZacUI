# ============================================================
# LOAD ORDER IS THE ARCHITECTURE.
# Files share state through the `ns` table: each one declares
# `local Foo = ns.Foo` at the top for what it needs, and
# `ns.Bar = Bar` at the bottom for what it provides. A local is
# only bound to what ns held AT LOAD TIME, so a file can never
# be moved above the file that publishes what it imports.
# The four tiers below are ordered by that dependency, not by
# folder:
#   Core       palette, fonts, the module registry
#   UI         the primitives that skin and the widgets we build
#   Modules    one file per surface, each registering into Modules
#   Boot       apply, config UI, events, slash
#
# THE PARTS. The big self-contained pieces live in their own addons
# next to this one, each a tick box in the AddOns list:
#   Zacui_Bars        action bars + bar loadouts   (Bartender4, Myslot)
#   Zacui_Bags        combined bag + auction house
#   Zacui_Nameplates  nameplates, plate scripts, soft target, crosshair
#   Zacui_Meter       damage meter + threat         (Details!)
#   Zacui_Maps        world/battlefield map + minimap markers
#   Zacui_RaidMods    boss mods for the classic raids PRIVATE
#   Zacui_WorldMap    the seamless stitched world map  (OpenMap, MIT)
#   Zacui_QoL         quality of life               (Leatrix Plus)
#   Zacui_Windows     the rebuilt game windows
#   Zacui_HUD         class HUDs + Drink Ticker
#   Zacui_UnitFrames  unit frames + incoming heals   (was ZacUF; own namespace)
#   Zacui_Auras       the aura engine (runs WeakAuras-format auras)
#   Zacui_RaidTools   /pull /break /range, raid sync, speech settings
#   Zacui_SBT         scrolling combat text
# They depend on this addon, load after all of it, and share its
# namespace (_G.ZacUI, published by Core_Boot) and its saved variables,
# so a setting is a setting wherever the code that reads it lives. Core
# never binds a part's symbol at load time - it looks it up when it
# needs it and copes with it being absent.
# ============================================================

# ---------- Libraries ----------
# LibStub, CallbackHandler, LibDataBroker and LibDBIcon: the minimap
# button is a LibDBIcon button so every button collector treats it like
# any other. LibStub picks the newest copy of each across all addons.
# WoW Forever: the old API names, put back where that client removed them (nothing on Era)
Core\Core_Forever.lua

Libs\LibStub\LibStub.lua
Libs\CallbackHandler-1.0\CallbackHandler-1.0.lua
Libs\LibDataBroker-1.1\LibDataBroker-1.1.lua
Libs\LibDBIcon-1.0\LibDBIcon-1.0.lua

# ---------- Core ----------
Core\Core_Boot.lua
# Which game this is (Classic Era, TBC, Forever) and what is off on each.
# Right after Boot: every later file and every part may ask.
Core\Core_Flavor.lua
# One filter for every list of buffs or debuffs (2026-11-10). After Flavor.
Core\Core_AuraFilter.lua
# SETUP2: every CVar ZacUI writes goes through ns.CVar (recorded, put back on
# disable / uninstall). Right after Flavor, before anything that writes one.
Core\Core_CVar.lua
# Feature cluster 1 (2026-11-07): /zui dev secrets, the developer's switch
# for the client's addon restrictions (through ns.CVar, so after it).
Core\Core_DevSecrets.lua
# One number formatter for every part (12.3k, separators, the parts' own
# styles), safe on values the client hides. After Flavor (ns.IsSecret).
Core\Core_Numbers.lua
# WoW Forever's surnames on ZacUI's names, and character keys by ruleset
# there (no realms). After Flavor (ns.IsSecret).
Core\Core_Names.lua
Core\Core_Colors.lua
Core\Core_MediaNames.lua
Core\Core_Sounds.lua
Core\Core_Fonts.lua
Core\Core_Registry.lua
Core\Core_Profiles.lua
Core\Core_SharedMedia.lua
Core\Core_Media.lua
# The Look: ZacUI's flat art or the game's own, read by every primitive
# below at build time. After media (it names ZacUI's textures), before
# the UI framework.
Core\Core_Look.lua
# The game's own panels in the worn look (Classic WoW UI on Forever /
# Retail) and ZacUI's dialogs' shared look helper. Right after the Look.
Core\Core_LookPanels.lua
# HD polish (2026-11-07): edges one physical pixel thick under the ZacUI
